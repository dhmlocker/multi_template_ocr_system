{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-template OCR ROI configuration",
  "type": "object",
  "required": ["template_name", "reference_width", "reference_height", "fields"],
  "properties": {
    "template_name": {"type": "string", "minLength": 1},
    "reference_width": {"type": "integer", "minimum": 1},
    "reference_height": {"type": "integer", "minimum": 1},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_name", "bbox"],
        "properties": {
          "field_name": {"type": "string", "minLength": 1},
          "bbox": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
          },
          "match_mode": {
            "type": "string",
            "enum": ["center", "iou", "center_or_iou"],
            "default": "center"
          },
          "iou_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.1
          }
        }
      }
    }
  }
}
